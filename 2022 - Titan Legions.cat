              <selectionEntries>
                <selectionEntry name="Sinistramanus Tenebrae" id="09b4-5481-6b61-38bc" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Dark Pulse" id="1373-9a90-af08-926f" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="95ba-cda7-b831-6066">48&quot;</characteristic>
                        <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">10</characteristic>
                        <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">1</characteristic>
                        <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 1, 7&quot; Blast, Ordnance, Psychic*, Destroyer, Soul-Sever</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Psychic Projection" id="9abd-f88e-3c10-f52a" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="95ba-cda7-b831-6066">24&quot;</characteristic>
                        <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">*</characteristic>
                        <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">—</characteristic>
                        <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 1, Torrent (Template), Psychic*, Madness Veil</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Soul-Sever" id="0f08-db87-00c4-7d60" hidden="false">
                      <description>Any unit (including Super-Heavies and Titans) that suffers an unsaved Wound or Hull Point loss from this weapon must immediately take a Morale Test at -3.


If failed, non-Super-Heavy units Flee.


Super-Heavy/Titan units suffer the Suppressed condition and cannot execute Reactions until the end of the next turn.</description>
                    </rule>
                    <rule name="Madness Veil" id="a761-55b3-36c2-1cc9" hidden="false">
                      <description>Does not use Strength to resolve hits.


Non-Vehicle Units: Any model touched by the template must pass a Leadership Test or be removed from play as a casualty (no saves of any kind permitted).


Vehicles / Walkers / Titans: Hit targets suffer an automatic Glancing Hit on a 2+ and must re-roll successful Invulnerable saves taken against this weapon.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
