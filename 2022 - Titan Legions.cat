            <profile name="Graviton Obliterator" id="43f9-1934-2713-ad25" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="95ba-cda7-b831-6066">60&quot;</characteristic>
                <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">*</characteristic>
                <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">2</characteristic>
                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">eavy 1, 7&quot; Blast, Ordnance, Graviton Collapse*, Concussive (2)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Graviton Collapse" id="fc84-7097-144c-0476" hidden="false">
              <description>Against Vehicles / Super-Heavies / Walkers: Roll 1D6 per hit. On a 2–4, the target suffers a Glancing Hit. On a 5–6, the target suffers a Penetrating Hit. Additionally, force successful Invulnerable Saves to be re-rolled.


Against Non-Vehicle Units: Models hit must pass a Strength Test at -2 or immediately lose 1 Wound (no armor/cover saves permitted).


Crush Fortifications: Ignores cover and inflicts double Hull Point damage to Buildings and Fortifications.</description>
            </rule>
          </rules>
        </selectionEntry>
