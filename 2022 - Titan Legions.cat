                <characteristic name="HP" typeId="2490-aa2f-f5db-6070">30</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Aura of Dread" id="7fed-18d4-3657-222d" hidden="false">
              <description>All enemy units within 24&quot; of the Warlord-Sinister suffer a -2 penalty to Leadership and cannot use Know No Fear or leadership-buffing abilities.</description>
            </rule>
            <rule name="Psi-Shielding" id="df41-5797-f2f0-b987" hidden="false">
              <description>Once per game turn, when the Warlord-Sinister fails a Void Shield or Armor save against a weapon with the Destroyer rule, it may take a Psychic Test (LD 10). If passed, the damage is completely negated.</description>
            </rule>
            <rule name="Necrotic Dissolution" id="5246-0ab9-56a9-a83a" hidden="false">
              <description>If the Warlord-Sinister suffers a Catastrophic Explosion, all units within the explosion radius suffer an additional D3 automatic Strength 10 AP 1 hits as psychic energy detonates outward.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Left Arm Weapon" id="8acc-8dd8-3994-a903" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="aa4a-3f73-813d-8431" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
