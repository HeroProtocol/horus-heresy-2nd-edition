        <selectionEntry name="Natrix Shock Lance" id="e15b-21a3-b167-9f68" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Natrix Shock Lance" id="19ae-12cb-645b-af5a" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="95ba-cda7-b831-6066">18&quot;</characteristic>
                <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">9</characteristic>
                <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">2</characteristic>
                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 1, Impaling Hook*, Shock Pulse Pinning</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Impaling Hook" id="95bd-9289-a372-06dd" hidden="false">
              <description>If this weapon scores a Penetrating Hit against a Vehicle, Super-Heavy, or Dreadnought, the target is dragged off-balance. The target suffers a -2 penalty to its Movement and -1 to hit on all shooting attacks during its next turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Ursus Claw" id="94cc-ba4c-5af4-03ba" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Ursus Claw" id="00c6-3da8-5b66-4c68" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="95ba-cda7-b831-6066">12&quot;</characteristic>
                <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">8</characteristic>
                <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">3</characteristic>
                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 1, Harpoon Drag*</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Harpoon Drag" id="b9f2-e124-a9c1-3a0f" hidden="false">
              <description>When a hit is scored against a Vehicle, Super-Heavy, or Walker, do not roll for damage immediately. Instead, make a contested Strength test: roll a D6 and add the Dire Wolf’s remaining Hull Points against a D6 + the target&apos;s remaining Hull Points/Wounds. If the Dire Wolf wins, the target is pulled D6&quot; toward the Dire Wolf, knocked Prone (if a Walker), or automatically suffers D3 automatic Glancing Hits (if a Vehicle/Super-Heavy).</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Shudder Missiles" id="0c35-6c5a-ab5c-0c90" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Shudder Missiles" id="f581-2620-5284-7b55" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="95ba-cda7-b831-6066">24&quot;–72&quot;</characteristic>
                <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">7</characteristic>
                <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">4</characteristic>
                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 2, Ordnance, 5&quot; Blast, Quake, Stunner</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Quake" id="edf9-db31-04f5-c3ae" hidden="false">
              <description>Units hit (including Vehicles) count all open terrain as Dangerous Terrain until the start of your next turn.</description>
            </rule>
            <rule name="Stunner" id="1931-11c5-28ed-e035" hidden="false">
              <description>Any non-Super-Heavy unit struck by this weapon must pass a Leadership test or immediately suffer the Suppressed condition.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Swarmer Missiles" id="9d39-2387-04d6-5fa4" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Swarmer Missiles" id="d1b3-1292-1423-62a0" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="95ba-cda7-b831-6066">48&quot;</characteristic>
                <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">6</characteristic>
                <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">3</characteristic>
                <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Heavy 4, 3&quot; Blast, Cluster Suppression, Barrage</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Cluster Suppression" id="6172-0d7c-44ea-9192" hidden="false">
              <description>Roll an additional $D3$ hits for every 5 models in the target unit after placing the initial blast templates.</description>
            </rule>
          </rules>
        </selectionEntry>
